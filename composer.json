{
	"name": "rare-gaming-dump/boxedmedia",
	"type": "mediawiki-extension",
	"description": "Routes MediaWiki's ImageMagick and SVG transforms through Shellbox, so no host commands needs to exist on the wiki host.",
	"license": "MIT",
	"homepage": "https://www.github.com/Rare-Gaming-Dump/BoxedMedia",
	"require": {
		"php": ">=8.1.0"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "45.0.0",
		"mediawiki/mediawiki-phan-config": "0.14.0",
		"mediawiki/minus-x": "1.1.3",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"test": [
			"parallel-lint . --exclude vendor --exclude node_modules",
			"@phpcs",
			"minus-x check ."
		],
		"fix": [
			"minus-x fix .",
			"phpcbf --standard=.phpcs.xml ."
		],
		"phpcs": "phpcs -sp --cache --standard=.phpcs.xml .",
		"phan": "phan -d . --long-progress-bar"
	},
	"config": {
		"optimize-autoloader": true,
		"prepend-autoloader": false,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		}
	}
}
